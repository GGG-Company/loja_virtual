generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                  String         @id @default(cuid())
  name                String?
  email               String         @unique
  emailVerified       DateTime?
  password            String?
  image               String?
  phone               String?
  cpf                 String?
  cnpj                String?
  stateRegistration   String?
  addressZip          String?
  addressStreet       String?
  addressNumber       String?
  addressComplement   String?
  addressNeighborhood String?
  addressCity         String?
  addressState        String?
  role                UserRole       @default(CUSTOMER)
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt
  accounts            Account[]
  carts               Cart?
  notifications       Notification[]
  orders              Order[]
  returns             Return[]
  reviews             Review[]
  sessions            Session[]

  @@index([email])
  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Category {
  id          String     @id @default(cuid())
  name        String
  slug        String     @unique
  description String?
  image       String?
  parentId    String?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]

  @@index([slug])
  @@map("categories")
}

model Product {
  id               String           @id @default(cuid())
  sku              String           @unique
  ean              String?
  slug             String           @unique
  name             String
  description      String?
  shortDescription String?
  imageUrl         String?
  price            Float
  compareAtPrice   Float?
  promotionalPrice Float?
  cost             Float?
  ncm              String?
  origin           String?
  stock            Int              @default(0)
  stockLocation    String?
  minStock         Int              @default(5)
  externalIdML     String?          @unique
  externalIdHiper  String?          @unique
  specs            Json?
  weight           Float?
  dimensions       Json?
  isFeatured       Boolean          @default(false)
  isPromo          Boolean          @default(false)
  isActive         Boolean          @default(true)
  metaTitle        String?
  metaDescription  String?
  categoryId       String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
  images           ProductImage[]
  variants         ProductVariant[]
  category         Category         @relation(fields: [categoryId], references: [id])
  reviews          Review[]
  stockLogs        StockLog[]

  @@index([sku])
  @@index([slug])
  @@index([categoryId])
  @@index([isFeatured])
  @@map("products")
}

model ProductVariant {
  id         String   @id @default(cuid())
  productId  String
  sku        String   @unique
  name       String
  price      Float?
  stock      Int      @default(0)
  attributes Json
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([sku])
  @@index([productId])
  @@map("product_variants")
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  sessionId String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[]
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionId])
  @@map("carts")
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id                  String        @id @default(cuid())
  orderNumber         String        @unique
  userId              String
  status              OrderStatus   @default(PENDING)
  subtotal            Float
  discount            Float         @default(0)
  shipping            Float         @default(0)
  total               Float
  paymentMethod       PaymentMethod
  installments        Int           @default(1)
  paymentId           String?
  paymentStatus       String?
  paidAt              DateTime?
  shippingAddress     Json
  trackingCode        String?
  trackingUrl         String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  melhorEnvioOrderId  String?
  melhorEnvioLabelId  String?
  melhorEnvioStatus   String?
  melhorEnvioService  String?
  melhorEnvioLabelUrl String?
  shippingServiceId   String?
  couponId            String?
  notes               String?
  adminNotes          String?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  items               OrderItem[]
  coupon              Coupon?       @relation(fields: [couponId], references: [id])
  user                User          @relation(fields: [userId], references: [id])
  returns             Return[]
  reviews             Review[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  price     Float
  discount  Float    @default(0)
  subtotal  Float
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Banner {
  id        String    @id @default(cuid())
  title     String
  imageUrl  String
  link      String?
  order     Int       @default(0)
  isActive  Boolean   @default(true)
  startDate DateTime?
  endDate   DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([isActive])
  @@map("banners")
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  description  String?
  discountType DiscountType
  value        Float
  scope        CouponScope  @default(GLOBAL)
  scopeValues  Json?
  minPurchase  Float?
  maxDiscount  Float?
  usageLimit   Int?
  usagePerUser Int?
  currentUsage Int          @default(0)
  isActive     Boolean      @default(true)
  startDate    DateTime?
  endDate      DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  orders       Order[]

  @@index([code])
  @@index([isActive])
  @@map("coupons")
}

model FinancialConfig {
  id                      String   @id @default("singleton")
  creditCardInterestRate  Float    @default(1.99)
  debitCardInterestRate   Float    @default(0)
  maxInstallments         Int      @default(12)
  minInstallmentValue     Float    @default(50.00)
  freeShippingMinValue    Float?   @default(200.00)
  defaultMarkupPercentage Float    @default(30.0)
  updatedAt               DateTime @updatedAt
  updatedBy               String?

  @@map("financial_config")
}

model ShippingRule {
  id        String           @id @default(cuid())
  active    Boolean          @default(true)
  type      ShippingRuleType
  states    Json?
  isFree    Boolean          @default(false)
  price     Float?
  minValue  Float?
  name      String?
  priority  Int              @default(100)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@index([active])
  @@index([type])
  @@index([priority])
  @@map("shipping_rules")
}

model StockLog {
  id          String      @id @default(cuid())
  productId   String
  source      StockSource
  previousQty Int
  newQty      Int
  difference  Int
  reason      String?
  userId      String?
  createdAt   DateTime    @default(now())
  product     Product     @relation(fields: [productId], references: [id])

  @@index([productId])
  @@index([source])
  @@index([createdAt])
  @@map("stock_logs")
}

model IntegrationLog {
  id           String   @id @default(cuid())
  endpoint     String
  method       String
  source       String?
  requestBody  Json?
  response     Json?
  statusCode   Int
  success      Boolean
  errorMessage String?
  createdAt    DateTime @default(now())

  @@index([endpoint])
  @@index([success])
  @@index([createdAt])
  @@map("integration_logs")
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  action    String
  entity    String
  entityId  String
  changes   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("activity_logs")
}

model Return {
  id                  String       @id @default(cuid())
  returnNumber        String       @unique
  orderId             String
  userId              String
  status              ReturnStatus @default(REQUESTED)
  reason              ReturnReason
  reasonDetails       String?
  imageUrl            String?
  videoUrl            String?
  refundAmount        Float?
  shippingRefund      Float?
  melhorEnvioOrderId  String?
  melhorEnvioLabelId  String?
  melhorEnvioLabelUrl String?
  trackingCode        String?
  trackingUrl         String?
  adminNotes          String?
  reviewedBy          String?
  reviewedAt          DateTime?
  refundMethod        String?
  refundedAt          DateTime?
  refundReference     String?
  shippedAt           DateTime?
  receivedAt          DateTime?
  inspectedAt         DateTime?
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt
  items               ReturnItem[]
  order               Order        @relation(fields: [orderId], references: [id])
  user                User         @relation(fields: [userId], references: [id])

  @@index([orderId])
  @@index([userId])
  @@index([status])
  @@index([returnNumber])
  @@map("returns")
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      String?
  isRead    Boolean          @default(false)
  readAt    DateTime?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ReturnItem {
  id          String   @id @default(cuid())
  returnId    String
  orderItemId String
  productId   String
  quantity    Int
  reason      String?
  condition   String?
  createdAt   DateTime @default(now())
  return      Return   @relation(fields: [returnId], references: [id], onDelete: Cascade)

  @@index([returnId])
  @@map("return_items")
}

model Review {
  id                 String    @id @default(cuid())
  productId          String
  userId             String
  orderId            String?
  rating             Int
  title              String?
  comment            String?
  isVerifiedPurchase Boolean   @default(false)
  isApproved         Boolean   @default(true)
  isHelpful          Int       @default(0)
  sellerResponse     String?
  sellerResponseAt   DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  order              Order?    @relation(fields: [orderId], references: [id])
  product            Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([rating])
  @@map("reviews")
}

model MelhorEnvioToken {
  id           String    @id @default("singleton")
  accessToken  String?
  refreshToken String?
  expiresAt    DateTime?
  scope        String?
  environment  String    @default("sandbox")
  updatedAt    DateTime  @updatedAt

  @@map("melhor_envio_token")
}

model MercadoPagoConfig {
  id            String   @id @default("singleton")
  publicKey     String?
  accessToken   String?
  environment   String   @default("sandbox")
  webhookSecret String?
  active        Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("mercado_pago_config")
}

enum UserRole {
  CUSTOMER
  ADMIN
  OWNER
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
  QUOTE
}

enum PaymentMethod {
  CREDIT_CARD
  DEBIT_CARD
  PIX
  BOLETO
  CASH
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum CouponScope {
  GLOBAL
  CATEGORY
  PRODUCT
  STATE
}

enum StockSource {
  ADMIN
  MERCADO_LIVRE
  HIPER
  PHYSICAL_STORE
  ECOMMERCE
}

enum ShippingRuleType {
  ALL
  STATE
}

enum ReturnStatus {
  REQUESTED
  PENDING_REVIEW
  APPROVED
  LABEL_GENERATED
  IN_TRANSIT
  RECEIVED
  INSPECTING
  REFUND_PENDING
  REFUNDED
  REJECTED
  CANCELLED
}

enum ReturnReason {
  DEFECTIVE
  WRONG_PRODUCT
  NOT_AS_DESCRIBED
  DAMAGED_SHIPPING
  CHANGED_MIND
  SIZE_ISSUE
  OTHER
}

enum NotificationType {
  ORDER_STATUS
  RETURN_STATUS
  PAYMENT
  PROMO
}

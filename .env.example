# ─────────────────────────────────────────────────────────────────────────────
# Ambiente
# ─────────────────────────────────────────────────────────────────────────────
NODE_ENV="development"

# ─────────────────────────────────────────────────────────────────────────────
# Banco de Dados (PostgreSQL)
# ─────────────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# ─────────────────────────────────────────────────────────────────────────────
# NextAuth / Auth.js
# Gere o secret com: openssl rand -base64 32
# ─────────────────────────────────────────────────────────────────────────────
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"
NEXT_APP_URL="http://localhost:3000"
# Em produção atrás de proxy reverso (nginx/Vercel), defina como "true"
AUTH_TRUST_HOST="true"

# ─────────────────────────────────────────────────────────────────────────────
# OAuth — Google
# https://console.cloud.google.com/apis/credentials
# ─────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# ─────────────────────────────────────────────────────────────────────────────
# Redis (cache, rate limiting, pub/sub, OAuth state)
# Formato: redis://[:password@]host:port[/db]
# ─────────────────────────────────────────────────────────────────────────────
REDIS_URL="redis://localhost:6379"

# ─────────────────────────────────────────────────────────────────────────────
# Segurança interna
# Gere com: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────────────
# Chave para chamadas internas (n8n, scripts, workers)
X_INTERNAL_API_KEY="your-internal-api-key"
# Secret para endpoints Cron (Vercel Cron / agendador externo)
# Gere com: openssl rand -hex 32
CRON_SECRET="your-cron-secret"

# ─────────────────────────────────────────────────────────────────────────────
# Aplicação
# ─────────────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME="Feira das Ferramentas"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# URL do WebSocket (socket.io) — geralmente igual ao APP_URL
NEXT_PUBLIC_SOCKET_URL="http://localhost:3000"

# ─────────────────────────────────────────────────────────────────────────────
# E-mail (SMTP)
# Para dev local use Mailhog/Mailpit na porta 1025 (sem auth)
# ─────────────────────────────────────────────────────────────────────────────
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# ─────────────────────────────────────────────────────────────────────────────
# IA — OpenAI (assistente de chat, opcional)
# ─────────────────────────────────────────────────────────────────────────────
OPENAI_API_KEY="sk-..."

# ─────────────────────────────────────────────────────────────────────────────
# n8n — Automação
# ─────────────────────────────────────────────────────────────────────────────
N8N_ORDERS_WEBHOOK_URL="https://your-n8n-instance.com/webhook/pedidos"

# ─────────────────────────────────────────────────────────────────────────────
# Hiper ERP — Integração de Estoque
# Credenciais do painel Hiper (Configurações > API)
# ─────────────────────────────────────────────────────────────────────────────
HIPER_API_SECRET_KEY="your-hiper-secret-key"
HIPER_API_TOKEN="your-hiper-api-token"
# Secret para autenticar webhooks recebidos do Hiper
# Gere com: openssl rand -hex 32
HIPER_WEBHOOK_SECRET="your-hiper-webhook-secret"

# ─────────────────────────────────────────────────────────────────────────────
# Dados da Loja — Remetente para etiquetas de envio (Melhor Envio)
# ─────────────────────────────────────────────────────────────────────────────
STORE_NAME="Sua Loja"
STORE_EMAIL="contato@sualoja.com.br"
STORE_PHONE="00000000000"
# Pessoa Física: preencher CPF | Pessoa Jurídica: preencher CNPJ + IE
STORE_CPF=""
STORE_CNPJ=""
STORE_IE=""
# Endereço completo do remetente
STORE_ADDRESS="Rua Exemplo"
STORE_NUMBER="100"
STORE_COMPLEMENT=""
STORE_DISTRICT="Centro"
STORE_CITY="Sua Cidade"
STORE_STATE="BA"

# ─────────────────────────────────────────────────────────────────────────────
# Melhor Envio — Cálculo de frete e geração de etiquetas
# https://melhorenvio.com.br/painel/gerenciar/tokens
# Para sandbox: sandbox.melhorenvio.com.br
# ─────────────────────────────────────────────────────────────────────────────
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_CLIENT_ID="your-me-client-id"
MELHOR_ENVIO_CLIENT_SECRET="your-me-client-secret"
MELHOR_ENVIO_CALLBACK="http://localhost:3000/api/integrations/melhor-envio/callback"
MELHOR_ENVIO_USER_AGENT="NomeDaLoja (contato@sualoja.com.br)"
MELHOR_ENVIO_SCOPES="cart-read cart-write companies-read companies-write coupons-read coupons-write notifications-read orders-read products-read products-write purchases-read shipment-cancel shipment-generate shipment-preview shipment-print shipment-share shipment-tracking tags-read tags-write users-read"
# Token de webhook do Melhor Envio (para receber notificações de rastreio)
MELHOR_ENVIO_WEBHOOK_TOKEN=""

# Frete — configurações de origem
# CEP de origem para cálculo de frete
SHIPPING_ORIGIN_ZIP="44002264"
ORIGIN_ZIP="44002264"
# IDs dos serviços habilitados (1=PAC, 2=SEDEX, 3=PAC Mini, 7=Jamef, 8=Azul, etc.)
MELHOR_ENVIO_SERVICES="1,2"

# ─────────────────────────────────────────────────────────────────────────────
# Mercado Pago — Pagamentos
# https://www.mercadopago.com.br/developers/panel/credentials
# Sandbox: chaves começam com "TEST-"
# Produção: chaves começam com "APP_USR-"
# ─────────────────────────────────────────────────────────────────────────────
MERCADO_PAGO_SANDBOX="true"
MERCADO_PAGO_PUBLIC_KEY="TEST-..."
MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="TEST-..."
# Secret para validar assinatura HMAC dos webhooks do MP
# Obtido em: Painel MP > Webhooks > chave secreta
MERCADO_PAGO_WEBHOOK_SECRET="your-mp-webhook-secret"
# Apenas para sandbox: aprova pagamentos automaticamente (true/false)
SANDBOX_AUTO_APPROVE="false"

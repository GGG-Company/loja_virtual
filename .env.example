# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dbname?schema=public"

# NextAuth
# Generate a secret using: openssl rand -base64 32
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# API Security
# Generate a 32-byte hex key for integrations (n8n, scripts, etc)
X_INTERNAL_API_KEY="your-internal-api-key"

# AI Assistant (Vercel AI SDK)
OPENAI_API_KEY="your-openai-api-key-optional"

# Email (SMTP)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_USER=""
SMTP_PASSWORD=""

# Application
NEXT_PUBLIC_APP_NAME="Shopping das Ferramentas"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# n8n Integration
N8N_ORDERS_WEBHOOK_URL="https://your-n8n-webhook-url/webhook/pedidos"

# Melhor Envio
MELHOR_ENVIO_TOKEN=""
MELHOR_ENVIO_SANDBOX="true"
MELHOR_ENVIO_CLIENT_ID=""
MELHOR_ENVIO_CLIENT_SECRET=""
MELHOR_ENVIO_CALLBACK="http://localhost:3000/api/integrations/melhor-envio/callback"
MELHOR_ENVIO_USER_AGENT="Loja Virtual (seu-email@exemplo.com)"

# Frete
SHIPPING_ORIGIN_ZIP="44002264"
MELHOR_ENVIO_SERVICES="1,2"

# Dados da Loja (Remetente para etiquetas)
STORE_NAME="Sua Loja"
STORE_PHONE="00000000000"
STORE_EMAIL="contato@sualoja.com.br"
STORE_CPF="000.000.000-00"
STORE_CITY="Feira de Santana"
STORE_STATE="BA"

# Mercado Pago
# KEYS do Sandbox começam com "TEST-"
MERCADO_PAGO_PUBLIC_KEY="TEST-..."
MERCADO_PAGO_ACCESS_TOKEN="TEST-..."
MERCADO_PAGO_SANDBOX="true"
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY="TEST-..."
